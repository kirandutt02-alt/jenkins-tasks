<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://maven.apache.org/POM/4.0.0
        https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- ============================= -->
	<!-- Project Information            -->
	<!-- ============================= -->
	<groupId>com.example</groupId>
	<artifactId>jenkins-demo</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<!-- ============================= -->
	<!-- Project Properties             -->
	<!-- ============================= -->
	<properties>
		<!-- Java -->
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<!-- Encoding -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- JUnit -->
		<junit.version>5.10.0</junit.version>
		<!-- Plugin Versions -->
		<maven.compiler.version>3.13.0</maven.compiler.version>
		<maven.surefire.version>3.1.2</maven.surefire.version>
		<maven.checkstyle.version>3.6.0</maven.checkstyle.version>
		<jacoco.version>0.8.13</jacoco.version>
	</properties>
	<!-- ============================= -->
	<!-- Dependencies                   -->
	<!-- ============================= -->
	<dependencies>
		<!-- JUnit 5 -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<!-- ============================= -->
	<!-- Build Configuration            -->
	<!-- ============================= -->
	<build>
		<finalName>jenkins-demo</finalName>
		<plugins>
			<!-- ============================= -->
			<!-- Maven Compiler                 -->
			<!-- ============================= -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.version}</version>
				<configuration>
					<source>17</source>
					<target>17</target>
				</configuration>
			</plugin>
			<!-- ============================= -->
			<!-- Maven Surefire - Unit Tests     -->
			<!-- ============================= -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.version}</version>
				<configuration>
					<useModulePath>false</useModulePath>
				</configuration>
			</plugin>
			<!-- ============================= -->
			<!-- Checkstyle - Code Quality      -->
			<!-- ============================= -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven.checkstyle.version}</version>
				<configuration>
					<!-- Show Checkstyle violations in Jenkins console -->
					<consoleOutput>true</consoleOutput>
					<!-- Generate Checkstyle XML report -->
					<outputFile>
                        ${project.build.directory}/checkstyle-result.xml
                    </outputFile>
					<!-- Do not fail Maven because of Checkstyle violations -->
					<failOnViolation>false</failOnViolation>
					<!-- Do not fail because of Checkstyle execution errors -->
					<failsOnError>false</failsOnError>
				</configuration>
			</plugin>
			<!-- ============================= -->
			<!-- JaCoCo - Code Coverage         -->
			<!-- ============================= -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<!-- Attach JaCoCo agent before tests -->
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<!-- Generate coverage report -->
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<!-- ============================= -->
	<!-- Reporting                     -->
	<!-- ============================= -->
	<reporting>
		<plugins>
			<!-- Checkstyle Report -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven.checkstyle.version}</version>
			</plugin>
		</plugins>
	</reporting>
</project>
